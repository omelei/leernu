{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],

        "_comment_third_party": "No request may leave our own origin. This is the product's central promise, not a performance nicety, so it is an error rather than a warning.",
        "third-party-facades": "off",
        "uses-rel-preconnect": "off",

        "_comment_fonts": "Self-hosted fonts are the point; Lighthouse's advice to preconnect to a CDN is advice we refuse.",
        "font-display": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
