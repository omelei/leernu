# Build output. tools/content/build-*.mjs writes these minified on purpose:
# they are fetched by a child on a school network, and every byte of
# indentation is a byte nobody asked for. Prettier expanding them also puts the
# formatter and the pipeline permanently at odds — regenerate, and format:check
# fails again.
public/geo/
# Also generated — tools/content/build-neighbours.mjs — and for the same
# second reason: it is written indented so a reviewer can read the diff, and
# Prettier would fill its arrays back onto one line each regeneration. What
# guards this file is src/content/neighbours.test.ts, which is a stronger gate
# than its indentation.
content/buren/
dist/
playwright-report/
lighthouse-report/
node_modules/

# The design files are the designer's own artefacts, exported from Claude
# Design. Reformatting them is at best pointless and at worst destroys
# structure the canvas depends on — and it guarantees a conflict the next time
# they are exported.
docs/*.html
docs/*.dc.html
# The per-screen sheets are the same kind of thing: standalone pages written to
# be read and marked up by hand, one screen at a time.
docs/schermen/*.html

# Generated by npm, not by anyone.
package-lock.json
# Generated by tools/content/build-vlaggen.mjs, indented so a reviewer can read
# the diff, and ignored for the reason content/buren/ is: Prettier would fold its
# arrays back onto one line at every regeneration. vlaggen.content.test.ts guards it.
content/vlaggen/vlaggen.json
